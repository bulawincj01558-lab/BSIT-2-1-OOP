<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.liceo.ugoautomate.ui.common.ProfileController" styleClass="page">
    <fx:define>

        <TextField fx:id="email" editable="false"/>
        <TextField fx:id="accountType" editable="false"/>
        <TextField fx:id="studentNumber" editable="false"/>
        <TextField fx:id="firstName"/>
        <TextField fx:id="lastName"/>
        <TextField fx:id="contact"/>
        <ComboBox fx:id="course" maxWidth="Infinity"/>
        <ComboBox fx:id="yearLevel" maxWidth="Infinity"/>
        <TextField fx:id="purpose"/>
        <TextField fx:id="personToVisit"/>
        <TextField fx:id="position"/>
    </fx:define>

    <Label text="My Profile" styleClass="page-title"/>
    <Label text="Email and student ID identify your account and cannot be changed here."
           styleClass="page-subtitle" wrapText="true"/>

    <GridPane fx:id="columns" hgap="20" vgap="20">
        <VBox styleClass="card">
            <GridPane fx:id="form" styleClass="form">
                <columnConstraints>
                    <ColumnConstraints minWidth="170"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
            </GridPane>
            <HBox alignment="CENTER_RIGHT">
                <Button text="Save changes" styleClass="primary" onAction="#save"/>
            </HBox>
        </VBox>

        <VBox styleClass="card">
            <Label text="Change password" styleClass="section-title"/>
            <GridPane styleClass="form">
                <columnConstraints>
                    <ColumnConstraints minWidth="170"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Current password" GridPane.rowIndex="0"/>
                <PasswordField fx:id="currentPassword" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="New password" GridPane.rowIndex="1"/>
                <PasswordField fx:id="newPassword" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Confirm new password" GridPane.rowIndex="2"/>
                <PasswordField fx:id="confirmPassword" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>
            <Label text="At least 8 characters with a letter and a number." styleClass="muted" wrapText="true"/>
            <HBox alignment="CENTER_RIGHT">
                <Button text="Change password" onAction="#changePassword"/>
            </HBox>
        </VBox>
    </GridPane>
</VBox>
