<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.liceo.ugoautomate.ui.student.SubjectPickerController" styleClass="card" maxWidth="560">
    <Label text="Subject" styleClass="section-title"/>
    <FlowPane styleClass="toolbar">
        <ComboBox fx:id="subjects" promptText="Choose a subject" prefWidth="420"/>
        <Button text="Refresh" onAction="#reload"/>
    </FlowPane>
    <Label fx:id="status" styleClass="muted" wrapText="true"/>
</VBox>
