<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.liceo.ugoautomate.ui.admin.AttendanceSessionsController" styleClass="page">
    <Label text="Attendance Sessions" styleClass="page-title"/>
    <Label text="Each session's QR code is signed, bound to that session, and accepted only while it is open."
           styleClass="page-subtitle" wrapText="true"/>

    <FlowPane styleClass="toolbar">
        <Button text="New session" styleClass="primary" onAction="#create"/>
        <Button text="Edit..." onAction="#edit"/>
        <Button text="Show QR code" onAction="#showQr"/>
        <Button text="View attendance" onAction="#viewRecords"/>
        <Button text="Delete" styleClass="danger" onAction="#delete"/>
        <Button text="Refresh" onAction="#reload"/>
    </FlowPane>

    <TableView fx:id="table" minHeight="260" VBox.vgrow="ALWAYS"/>
</VBox>
