<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.liceo.ugoautomate.ui.admin.AttendanceRecordsController" styleClass="page">
    <Label text="Attendance Records" styleClass="page-title"/>
    <Label text="Who attended, and when their attendance was recorded." styleClass="page-subtitle" wrapText="true"/>

    <FlowPane styleClass="toolbar">
        <Label text="Session:"/>
        <ComboBox fx:id="sessionFilter" prefWidth="340" onAction="#filterChanged"/>
        <Button text="Refresh" onAction="#refresh"/>
        <Button text="Delete record" styleClass="danger" onAction="#deleteSelected"/>
        <Label fx:id="count" styleClass="muted"/>
    </FlowPane>

    <TableView fx:id="table" minHeight="260" VBox.vgrow="ALWAYS"/>
</VBox>
