<?xml version="1.0" encoding="UTF-8"?>

<?import edu.liceo.ugoautomate.ui.common.SpinningLogo?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.liceo.ugoautomate.ui.LoginController"
            fx:id="scroller" styleClass="page-scroll">
    <GridPane fx:id="split">
        <VBox styleClass="brand-panel" maxHeight="Infinity">
            <Label text="Liceo&#10;U Go Automate" styleClass="brand-name" wrapText="true"/>
            <Label fx:id="university" styleClass="brand-university" wrapText="true"/>
            <Label styleClass="brand-tagline" wrapText="true"
                   text="QR attendance, campus entry verification, and data structures in one place."/>

            <Region VBox.vgrow="ALWAYS" minHeight="8"/>
            <HBox alignment="CENTER">
                <SpinningLogo size="220" fire="true"/>
            </HBox>
            <Region VBox.vgrow="ALWAYS" minHeight="0" maxHeight="70"/>
        </VBox>

        <VBox styleClass="login-form" maxHeight="Infinity">
            <Label text="Welcome back" styleClass="page-title"/>
            <Label text="Log in with your registered email and password." styleClass="page-subtitle" wrapText="true"/>

            <Label text="Email"/>
            <TextField fx:id="email" promptText="you@liceo.edu.ph" minWidth="320" prefWidth="320" maxWidth="320"/>
            <Label text="Password"/>
            <PasswordField fx:id="password" minWidth="320" prefWidth="320" maxWidth="320"/>
            <Label fx:id="message" wrapText="true" styleClass="error-text"/>

            <Button fx:id="loginButton" text="Log in" styleClass="primary" defaultButton="true"
                    minWidth="320" prefWidth="320" maxWidth="320" onAction="#login"/>

            <Label text="New here?" styleClass="muted"/>
            <FlowPane styleClass="toolbar">
                <Button text="Register as Student" onAction="#registerStudent"/>
                <Button text="Register as Guest" onAction="#registerGuest"/>
            </FlowPane>
        </VBox>
    </GridPane>
</ScrollPane>
