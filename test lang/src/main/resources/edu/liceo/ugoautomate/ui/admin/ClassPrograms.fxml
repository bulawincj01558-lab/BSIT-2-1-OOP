<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.liceo.ugoautomate.ui.admin.ClassProgramsController" styleClass="page">
    <Label text="Class Programs" styleClass="page-title"/>
    <Label text="Classes offered each term. Enroll students to build their class program; a student is never enrolled in two classes at the same time. The current term is set on the Evaluation Results page."
           styleClass="page-subtitle" wrapText="true"/>

    <FlowPane styleClass="toolbar">
        <Label text="Term:"/>
        <ComboBox fx:id="termFilter" prefWidth="280" onAction="#loadClasses"/>
        <Label fx:id="count" styleClass="muted"/>
    </FlowPane>
    <FlowPane styleClass="toolbar">
        <Button text="Add class" styleClass="primary" onAction="#add"/>
        <Button text="Edit..." onAction="#edit"/>
        <Button text="Students..." onAction="#students"/>
        <Button text="Delete" styleClass="danger" onAction="#delete"/>
        <Button text="Refresh" onAction="#refresh"/>
    </FlowPane>

    <TableView fx:id="table" minHeight="260" VBox.vgrow="ALWAYS"/>
</VBox>
