<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.liceo.ugoautomate.ui.student.ClassProgramController" styleClass="page">
    <Label text="My Class Program" styleClass="page-title"/>
    <Label text="Your classes this term, in weekly order. Contact the registrar if a class is missing or wrong."
           styleClass="page-subtitle" wrapText="true"/>

    <VBox styleClass="card">
        <Label fx:id="termLabel" styleClass="section-title" wrapText="true"/>
        <Label fx:id="totals" styleClass="muted" wrapText="true"/>
    </VBox>

    <FlowPane styleClass="toolbar">
        <Button text="Refresh" onAction="#reload"/>
    </FlowPane>
    <TableView fx:id="table" minHeight="260" VBox.vgrow="ALWAYS"/>
</VBox>
