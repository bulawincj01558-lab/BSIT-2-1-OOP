<?xml version="1.0" encoding="UTF-8"?>

<?import edu.liceo.ugoautomate.ui.common.QrView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.liceo.ugoautomate.ui.student.EntryQrController" styleClass="page">
    <Label text="My Entry QR" styleClass="page-title"/>
    <Label fx:id="help" styleClass="page-subtitle" wrapText="true"/>
    <Button text="Generate entry QR" styleClass="primary" onAction="#generate"/>
    <VBox styleClass="card" maxWidth="560">
        <QrView fx:id="qrView"/>
    </VBox>
</VBox>
