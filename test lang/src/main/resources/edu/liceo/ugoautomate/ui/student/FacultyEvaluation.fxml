<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.liceo.ugoautomate.ui.student.FacultyEvaluationController" styleClass="page">
    <Label text="Faculty Evaluation" styleClass="page-title"/>
    <Label text="Rate the teachers of your classes once per term. Your answers are anonymous: administrators see only averages and comments, never your name."
           styleClass="page-subtitle" wrapText="true"/>

    <VBox styleClass="card">
        <Label fx:id="periodLabel" styleClass="section-title" wrapText="true"/>
        <Label fx:id="progressLabel" styleClass="muted" wrapText="true"/>
    </VBox>

    <FlowPane styleClass="toolbar">
        <Button fx:id="evaluateButton" text="Evaluate..." styleClass="primary" onAction="#evaluate"/>
        <Button text="Refresh" onAction="#reload"/>
    </FlowPane>
    <TableView fx:id="table" minHeight="260" VBox.vgrow="ALWAYS"/>
</VBox>
