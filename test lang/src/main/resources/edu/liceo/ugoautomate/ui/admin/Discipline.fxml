<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.liceo.ugoautomate.ui.admin.DisciplineController" styleClass="page">
    <Label text="Discipline" styleClass="page-title"/>
    <Label text="Students' disciplinary cases. Each student can see only their own record."
           styleClass="page-subtitle" wrapText="true"/>

    <FlowPane styleClass="toolbar">
        <ComboBox fx:id="statusFilter" onAction="#reload"/>
        <TextField fx:id="search" promptText="Student name, student ID, or offense" prefColumnCount="22" onAction="#reload"/>
        <Button text="Search" onAction="#reload"/>
        <Label fx:id="count" styleClass="muted"/>
    </FlowPane>
    <FlowPane styleClass="toolbar">
        <Button text="New record" styleClass="primary" onAction="#add"/>
        <Button text="Edit..." onAction="#edit"/>
        <Button text="Mark resolved..." onAction="#resolve"/>
        <Button text="Delete" styleClass="danger" onAction="#delete"/>
    </FlowPane>

    <TableView fx:id="table" minHeight="240" VBox.vgrow="ALWAYS"/>

    <VBox styleClass="card">
        <Label fx:id="detailTitle" text="Select a case to see its details." styleClass="section-title" wrapText="true"/>
        <Label fx:id="detailText" wrapText="true"/>
    </VBox>
</VBox>
