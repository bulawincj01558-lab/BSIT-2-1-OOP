<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ph.edu.liceo.portal.controller.ProfileController"
            styleClass="profile-root">

    <top>
        <VBox alignment="CENTER" spacing="10" styleClass="profile-header">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="STUDENT PROFILE" styleClass="header-caption"/>
            <Label fx:id="initialsLabel" styleClass="initials-circle"/>
            <Label fx:id="nameLabel" styleClass="name-label"/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="16" vgap="14">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <Label text="Student No.:" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="studentNoLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Course:" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="courseLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Email:" styleClass="detail-key" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="emailLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>
    </center>

    <bottom>
        <Button text="LOG OUT" maxWidth="Infinity" onAction="#handleLogout" styleClass="primary-button">
            <BorderPane.margin>
                <Insets top="0" right="20" bottom="20" left="20"/>
            </BorderPane.margin>
        </Button>
    </bottom>
</BorderPane>